{
  "expo": {
    "name": "FreePlay",
    "slug": "FreePlay",
    "scheme": "freeplay",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.freeplay"
    },
    "android": {
      "package": "com.anonymous.freeplay",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon-free-play.png",
        "monochromeImage": "./assets/images/monochrome-icon.png",
        "backgroundColor": "#0A1220"
      }
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "2.0.21"
          }
        }
      ],
      "expo-router",
      "expo-audio",
      "expo-sqlite",
      [
        "expo-media-library",
        {
          "granularPermissions": [
            "audio"
          ]
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
